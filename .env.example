# One 10 Events — environment template
# Copy to backend/.env and adjust. Never commit real secrets.

# --- Database (required) ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=one10_events

# --- Signing ---
RECEIPT_TOKEN_SECRET=change-me-to-a-long-random-string
APP_URL=https://one10events.in

# --- Auth ---
# Comma-separated emails that become system_admin+convenor on first login
BOOTSTRAP_ADMIN_EMAILS=convenor@example.com

# --- Razorpay ---
# mode: test | live
# Temporary option: reuse Anchol Katha live keys until EOC One10 merchant is ready.
# Settlements will go to whichever Razorpay account these keys belong to.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional email ---
EMAIL_PROVIDER=

# --- Object storage + LLM vision (payment screenshot extract) ---
INTEGRATION_PROXY_URL=
EMERGENT_LLM_KEY=
# Optional vision model override (default gpt-4o via Emergent proxy)
# PAYMENT_VISION_MODEL=gpt-4o

# Public subscribe uses UPI QR + screenshot upload, plus optional Cashfree checkout.

# --- Cashfree (temporary: reuse Anchol Katha gateway until One10 merchant is ready) ---
# Sandbox App IDs start with TEST. Settlements go to the Cashfree merchant these keys belong to.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_MODE=sandbox
CASHFREE_ALLOW_SANDBOX_ON_PRODUCTION=true

# --- Frontend (export when starting CRA; not read by backend) ---
# REACT_APP_BACKEND_URL=http://localhost:8000
# Optional build-time Cashfree mode fallback (runtime uses /api/config.payment.cashfree)
# REACT_APP_CASHFREE_MODE=sandbox
# REACT_APP_CASHFREE_ENABLED=true
