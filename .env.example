# One 10 Events — environment template
# Copy to backend/.env and adjust. Never commit real secrets.

# --- Database (required) ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=one10_events

# --- Signing ---
RECEIPT_TOKEN_SECRET=change-me-to-a-long-random-string
APP_URL=https://one10events.in

# --- Auth ---
# Comma-separated emails that become system_admin+convenor on first login
BOOTSTRAP_ADMIN_EMAILS=convenor@example.com

# --- Payments ---
# Public payments use uploaded UPI QR + screenshot submit only.
# No Razorpay / Cashfree gateway keys are required.

# --- Optional email ---
EMAIL_PROVIDER=

# --- Object storage + LLM vision (payment screenshot extract) ---
INTEGRATION_PROXY_URL=
EMERGENT_LLM_KEY=
# Optional vision model override (default gpt-4o via Emergent proxy)
# PAYMENT_VISION_MODEL=gpt-4o

# --- Frontend (export when starting CRA; not read by backend) ---
# REACT_APP_BACKEND_URL=http://localhost:8000
